# Database (sync psycopg; Phase 1 async engine will use postgresql+asyncpg://)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname?sslmode=disable

# Redis (Celery broker / rate limiting, Phase 4+)
REDIS_URL=redis://localhost:6379/0

# LLM
DEEPSEEK_API_KEY=

# Auth (Phase 2+)
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
